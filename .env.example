# Copy to .env and fill in. .env is git-ignored; never commit real credentials.

# OpenSky Network API client (https://opensky-network.org > Account > API clients).
# Optional: without these the poller runs anonymously (400 credits/day, 20-minute cadence).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# live | record | replay   (replay serves data/recordings/opensky and makes no API calls)
FCP_OPENSKY_MODE=live

# Local Postgres (docker compose). Defaults shown; change the password if you expose the port.
FCP_PG_USER=fcp
FCP_PG_PASSWORD=fcp_local_only
FCP_PG_DB=fcp
FCP_PG_PORT=5432

# Number of BTS on-time months to keep in the lake
FCP_BTS_ONTIME_MONTHS=6
